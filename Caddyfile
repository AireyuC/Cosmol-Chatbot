{$DOMAIN_NAME:chatbot.cosmol.com.bo} {
    # Servir imágenes estáticas desde /uploads
    handle_path /uploads/* {
        root * /var/www/html/uploads
        file_server
    }

    # Todo lo demás va hacia n8n
    handle {
        reverse_proxy cosmol_n8n:5678
    }
}

# Dashboard COSMOL-Reportes con SSL en puerto 8081
{$DOMAIN_NAME:chatbot.cosmol.com.bo}:8081 {
    reverse_proxy host.docker.internal:8082
}

# Backend COSMOL-App de Socios con SSL en puerto 8083
{$DOMAIN_NAME:chatbot.cosmol.com.bo}:8083 {
    # 1. Reverse proxy hacia la API FastAPI
    handle /api/* {
        reverse_proxy host.docker.internal:8000
    }

    # 2. Documentacion interactiva Swagger
    handle /docs* {
        reverse_proxy host.docker.internal:8000
    }
    handle /openapi.json {
        reverse_proxy host.docker.internal:8000
    }

    # 3. Verificacion de salud del Gateway
    handle {
        respond "COSMOL App de Socios API - Operativa en Puerto 8083 con SSL" 200
    }
}
