{$DOMAIN_NAME:chatbot.cosmol.com.bo} {
    # Servir imágenes estáticas desde /uploads
    handle_path /uploads/* {
        root * /var/www/html/uploads
        file_server
    }

    # Todo lo demás va hacia n8n
    handle {
        reverse_proxy cosmol_n8n:5678
    }
}

# Subdominio COSMOL-Reportes (Dashboard Administrativo)
{$DOMAIN_REPORTES:reportes.cosmol.com.bo} {
    reverse_proxy host.docker.internal:8081
}
