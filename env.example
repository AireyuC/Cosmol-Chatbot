# ==========================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ==========================================
# Instrucciones: Copia este archivo, renómbralo a ".env" 
# y reemplaza los valores de ejemplo por los reales de tu entorno.
# ¡Nunca subas el archivo ".env" real a GitHub!

# --- Configuración del Orquestador (n8n) ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
GENERIC_TIMEZONE=America/La_Paz

# URL pública para los Webhooks de Meta (WhatsApp)
# Dev: Tu URL de ngrok (Ej: https://tu-subdominio.ngrok-free.app/)
# Prod: Tu dominio real (Ej: https://chatbot.cosmol.com.bo/webhook/whatsapp)
WEBHOOK_URL=http://localhost:5678/

# --- Configuración SSL y Proxy Reverso (Caddy) ---
# Dominio real de producción sin http:// (ej. chatbot.cosmol.com.bo)
# En desarrollo local o con ngrok: localhost
DOMAIN_NAME=localhost

# --- Token de Acceso Meta Graph API (WhatsApp) ---
# Token de usuario del sistema utilizado para descargar fotos/archivos adjuntos
WHATSAPP_TOKEN=your_whatsapp_system_user_token_here

# --- Configuración de Base de Datos (PostgreSQL 16) ---
# Contenedor 'db' (PostgreSQL 16) en docker-compose
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=cosmol_sai
DB_USER=cosmol_dev
DB_PASSWORD=devpassword

# --- Entorno Aplicación Backend (PHP 7.3) ---
# Dev: APP_ENV=development, APP_DEBUG=true
# Prod: APP_ENV=production, APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true

# --- Seguridad de la API Interna ---
# Token secreto compartido entre n8n y la API PHP (Header X-Internal-Token)
# Generar en consola con: openssl rand -hex 32
API_INTERNAL_TOKEN=your_super_secret_token_here

# Origen permitido para CORS (n8n en red Docker interna)
# Dev: http://cosmol_n8n:5678
# Prod: https://tu_dominio_de_n8n.com
ALLOWED_ORIGIN=http://cosmol_n8n:5678

# --- API Externa COSMOL (Servidor Informix SAI) ---
# Dev: Dejar vacío para usar la base de datos PostgreSQL local simulada
# Prod: URL base de los microservicios REST de Informix (ej. http://192.168.1.X:8000)
COSMOL_API_URL=

# --- Integración COSMOL-Reportes (Métricas de Consultas de WhatsApp) ---
# Interruptor de Pusheo: true para enviar a Reportes, false para pausar (ej. en mantenimientos)
# Si está en false, el bot sigue guardando en cola_reportes sin emitir HTTP hacia afuera.
REPORTES_SYNC_ENABLED=true
# Dev: http://cosmol_app:80/api (en red Docker) o http://localhost:8080/api
# Prod: URL del servidor de COSMOL-Reportes
REPORTES_API_URL=
# Token secreto para autorizar el envío de métricas al sistema de reportes
REPORTES_API_TOKEN=
