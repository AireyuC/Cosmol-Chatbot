# ==========================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ==========================================
# Instrucciones: Copia este archivo, renómbralo a ".env" 
# y reemplaza los valores falsos por los reales.
# ¡Nunca subas el archivo ".env" real a GitHub!

# --- Configuración del Orquestador (n8n) ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
GENERIC_TIMEZONE=America/La_Paz

# URL pública para los Webhooks de Meta
# En desarrollo: Pon tu URL de ngrok (Ej: https://1234.ngrok.app)
# En producción: Pon tu dominio real (Ej: https://api.cosmol.com)
WEBHOOK_URL=http://tu-url-ngrok.ngrok-free.app/

# --- Configuración de Base de Datos (MySQL) ---
# Nota: DB_HOST debe ser 'db' para que PHP encuentre el contenedor de MySQL
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=nombre_de_tu_bd
DB_USER=usuario_de_tu_bd
DB_PASSWORD=password_secreto_bd
DB_ROOT_PASSWORD=password_super_secreto_root
DB_CHARSET=utf8mb4

# --- Entorno Aplicación (PHP) ---
APP_ENV=development
APP_DEBUG=true

# --- Seguridad (Token Interno) ---
# Token secreto compartido entre n8n y la API PHP (mínimo 32 caracteres)
# Generar con: openssl rand -hex 32
API_INTERNAL_TOKEN=your_super_secret_token_here

# Origen permitido para CORS (nombre del contenedor n8n en la red Docker)
# Dev: http://cosmol_n8n:5678 | Prod: https://tudominio.com
ALLOWED_ORIGIN=http://cosmol_n8n:5678

