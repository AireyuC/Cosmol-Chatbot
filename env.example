# ==========================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# ==========================================
# Instrucciones: Copia este archivo, renómbralo a ".env" 
# y reemplaza los valores falsos por los reales.
# ¡Nunca subas el archivo ".env" real a GitHub!

# --- Configuración del Orquestador (n8n) ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
GENERIC_TIMEZONE=America/La_Paz

# URL pública para los Webhooks de Meta
# Dev: Pon tu URL de ngrok (Ej: https://1234.ngrok.app)
# Prod: Pon tu dominio real (Ej: https://api.cosmol.com)
WEBHOOK_URL=http://tu-url-ngrok.ngrok-free.app/

# --- Configuración SSL (Caddy) ---
# Dominio real de producción sin http:// (ej. api.cosmol.com.bo)
DOMAIN_NAME=localhost

# Token de Acceso de Usuario del Sistema (WhatsApp API)
# Utilizado para descargar imágenes enviadas por los usuarios.
WHATSAPP_TOKEN=your_whatsapp_system_user_token_here

# --- Configuración de Base de Datos ---
# Dev: DB_HOST=db (nombre del contenedor), DB_DRIVER=pgsql
# Prod: DB_HOST=ip_produccion, DB_DRIVER=informix (cuando se habilite)
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=nombre_de_tu_bd
DB_USER=usuario_de_tu_bd
DB_PASSWORD=password_secreto_bd
DB_ROOT_PASSWORD=password_super_secreto_root
DB_CHARSET=utf8

# --- Entorno Aplicación (PHP) ---
# Dev: APP_ENV=development, APP_DEBUG=true
# Prod: APP_ENV=production, APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true

# --- Seguridad (Token Interno y CORS) ---
# Token secreto compartido entre n8n y la API PHP (mínimo 32 caracteres)
# IMPORTANTE: Generar con `openssl rand -hex 32`
API_INTERNAL_TOKEN=your_super_secret_token_here

# Origen permitido para CORS
# Dev: http://cosmol_n8n:5678 (o localhost si usas fuera de docker)
# Prod: https://tu_dominio_de_n8n.com
ALLOWED_ORIGIN=http://cosmol_n8n:5678

# --- API externa COSMOL (Integración Producción) ---
# Dev: Dejar COSMOL_API_URL vacío para usar la base de datos MySQL local simulada
# Prod: URL de la API real de Informix
COSMOL_API_URL=
COSMOL_API_TOKEN=
