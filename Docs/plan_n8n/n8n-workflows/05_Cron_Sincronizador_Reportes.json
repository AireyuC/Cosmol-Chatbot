{
  "name": "COSMOL - Sincronizador Periódico de Reportes (Cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Cada 5 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "id": "schedule-trigger-reportes"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cosmol_backend:80/api/cron_flush_reportes.php",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.API_INTERNAL_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "name": "Vaciar Cola Reportes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "id": "http-request-flush-reportes"
    }
  ],
  "pinData": {},
  "connections": {
    "Cada 5 Minutos": {
      "main": [
        [
          {
            "node": "Vaciar Cola Reportes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
